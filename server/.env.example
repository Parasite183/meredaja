# ── Meredaja server configuration ────────────────────────────────────
# Everything is optional in development (zero-config startup). In
# production NODE_ENV=production makes the missing items below hard
# errors — the server refuses to boot half-configured.

# PORT=3001
# DB_FILE=./data/meredaja.db
# DATABASE_URL=postgres://user:pass@host:5432/meredaja   # switch to PostgreSQL
# JWT_SECRET=change-me-to-a-long-random-string
# MEREDAJA_ENC_KEY=change-me-32-bytes-random-secret

# SMS: console (dev) | twilio | africastalking
# SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_FROM=MEREDAJA

# NODE_ENV=production
